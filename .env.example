# --- Credenciales EMT MobilityLabs (https://mobilitylabs.emtmadrid.es) -------------------
# Opción A: usuario/contraseña del portal (cuota "genérica", más baja).
EMT_EMAIL=tu-email@example.com
EMT_PASSWORD=tu-password
# Opción B (recomendada): registra una App en el portal y usa su ClientId/passKey.
# Si se rellenan, tienen prioridad sobre email/password.
EMT_CLIENT_ID=
EMT_PASS_KEY=

# --- Qué recolectar --------------------------------------------------------------------
# Líneas a seguir (etiqueta pública o id interno: 27, 045, C1...). Se consultan todas
# sus paradas en ambos sentidos. Obligatorio EMT_LINES y/o EMT_STOPS.
EMT_LINES=27,45
# Paradas adicionales concretas (ids EMT). En estas paradas se guardan TODAS las líneas.
EMT_STOPS=
# Cada cuántas horas se refresca la lista de paradas de las líneas.
EMT_STOPS_REFRESH_HOURS=24

# --- Ritmo y cuota ----------------------------------------------------------------------
COLLECT_INTERVAL_SECONDS=60
# Límite cliente de peticiones/minuto (token bucket).
EMT_MAX_REQUESTS_PER_MINUTE=100
# Presupuesto diario (hits/día) para avisar si la configuración lo excede.
EMT_DAILY_REQUEST_BUDGET=150000
EMT_REQUEST_TIMEOUT_SECONDS=15
EMT_MAX_RETRIES=4
EMT_BASE_URL=https://openapi.emtmadrid.es

# --- Base de datos ----------------------------------------------------------------------
# Credenciales del Postgres de docker-compose. POSTGRES_PASSWORD es obligatoria: genera una
# con `openssl rand -hex 24`. docker-compose construye DATABASE_URL a partir de estas tres.
POSTGRES_USER=emt
POSTGRES_PASSWORD=
POSTGRES_DB=emt
# Solo fuera de docker-compose (ejecución local / otra base de datos):
# DATABASE_URL=postgresql+psycopg://emt:<password>@localhost:5432/emt
# Intentar crear hypertables TimescaleDB (se degrada a Postgres normal si no está).
DB_USE_TIMESCALE=true

# --- Logging ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# json (producción) | console (desarrollo)
LOG_FORMAT=json
